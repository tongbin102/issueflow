              "    pm.expect(d).to.have.property('list');",
              "    pm.expect(d.list).to.be.an('array');",
              "});",
              "pm.test('T8-4 日志条目含 time/ip/success 字段', function () {",
              "    if (d.list.length > 0) {",
              "        ['time', 'ip', 'success'].forEach(function (k) { pm.expect(d.list[0]).to.have.property(k); });",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/profile/login-logs", "host": ["{{baseUrl}}"], "path": ["profile", "login-logs"] },
        "description": "预期：200，返回登录日志分页列表。"
      }
    }
  ]
