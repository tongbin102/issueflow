# 复制为 .env 后按需修改（docker compose 会自动读取）
# ⚠️ 自安全加固 M1 起 JWT_SECRET 为必填项：未填时 docker compose 直接报错退出（预期行为）；
#    其余变量留空则走 compose 内的默认值。

# MySQL
MYSQL_ROOT_PASSWORD=issueflow123
MYSQL_DB=issueflow
MYSQL_USER=root

# JWT（必填，≥32 字节强随机；生成命令：openssl rand -base64 48）
# 这里刻意不给示例值——仓库内不得出现任何可直接使用的密钥明文（安全加固 M1）。
JWT_SECRET=
JWT_EXPIRATION=7200
