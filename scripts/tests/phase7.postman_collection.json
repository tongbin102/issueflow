    {
      "name": "T6 个人中心资料 - GET /profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 契约断言：ProfileVO 必须同时暴露脱敏展示值(email/phone)与原值(emailRaw/phoneRaw)",
              "pm.test('T6-1 HTTP 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('T6-2 业务 code = 200', function () { pm.expect(body.code).to.eql(200); });",
              "var d = body.data || {};",
              "pm.test('T6-3 契约字段齐备', function () {",
              "    ['id', 'username', 'realName', 'email', 'phone', 'emailRaw', 'phoneRaw', 'roleName', 'roleCode', 'createdAt']",
              "        .forEach(function (k) { pm.expect(d, '缺少字段 ' + k).to.have.property(k); });",
              "});",
              "",
              "// 值语义断言：仅在存在原值时校验脱敏规则，否则视为数据前置不足（不判失败）",
              "pm.test('T6-4 邮箱脱敏规则 x***@domain（有原值时才校验）', function () {",
              "    if (d.emailRaw) { pm.expect(d.email).to.match(/^.\\*\\*\\*@/); }",
              "    else { pm.expect(d.email, '无原值时脱敏值应为空').to.satisfy(function (v) { return v === null || v === '' || v === undefined; }); }",
              "});",
              "pm.test('T6-5 手机脱敏规则 前3****后4（有原值时才校验）', function () {",
              "    if (d.phoneRaw) { pm.expect(d.phone).to.match(/^\\d{3}\\*{4}\\d{4}$/); }",
              "    else { pm.expect(d.phone, '无原值时脱敏值应为空').to.satisfy(function (v) { return v === null || v === '' || v === undefined; }); }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/profile", "host": ["{{baseUrl}}"], "path": ["profile"] },
        "description": "预期：200，data 含 emailRaw/phoneRaw 原值字段与脱敏后 email/phone。"
      }
    },
    {
      "name": "T7 个人中心活动-登录 - GET /profile/activities?type=LOGIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('T7-1 HTTP 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('T7-2 业务 code = 200', function () { pm.expect(body.code).to.eql(200); });",
              "var d = body.data || {};",
              "pm.test('T7-3 total >= 1', function () { pm.expect(d.total).to.be.at.least(1); });",
              "pm.test('T7-4 分页回显 page=1 size=5', function () {",
              "    pm.expect(d.page).to.eql(1);",
              "    pm.expect(d.size).to.eql(5);",
              "});",
              "pm.test('T7-5 列表非空且条数 <= size', function () {",
              "    pm.expect(d.list).to.be.an('array').with.length.above(0);",
              "    pm.expect(d.list.length).to.be.at.most(5);",
              "});",
              "pm.test('T7-6 首条 title 含【登录】', function () {",
              "    pm.expect(d.list[0].title).to.include('登录');",
              "});",
              "pm.test('T7-7 type 过滤生效（全部为 LOGIN）', function () {",
              "    d.list.forEach(function (it) { pm.expect(it.type).to.eql('LOGIN'); });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/profile/activities?type=LOGIN&page=1&size=5",
          "host": ["{{baseUrl}}"],
          "path": ["profile", "activities"],
          "query": [
            { "key": "type", "value": "LOGIN" },
            { "key": "page", "value": "1" },
            { "key": "size", "value": "5" }
          ]
        },
        "description": "预期：200，total>=1，首条 title 含“登录”，列表 type 全为 LOGIN。"
      }
    },
    {
      "name": "T8 登录日志 - GET /profile/login-logs",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 验证个人中心【活动】Tab 的数据来源可用",
              "pm.test('T8-1 HTTP 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('T8-2 业务 code = 200', function () { pm.expect(body.code).to.eql(200); });",
